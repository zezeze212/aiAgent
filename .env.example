# Docker Compose 本地 MySQL 配置
AI_AGENT_DB_PORT=3307
AI_AGENT_DB_NAME=ai_agent
AI_AGENT_DB_USERNAME=ai_agent

# 复制为 .env 后填写，不要提交真实密码
AI_AGENT_DB_PASSWORD=
AI_AGENT_DB_ROOT_PASSWORD=

# Docker Compose 本地 Qdrant 配置
AI_AGENT_QDRANT_HTTP_PORT=6333
AI_AGENT_QDRANT_GRPC_PORT=6334

# Spring AI Dense Vector RAG 配置
AI_AGENT_QDRANT_HOST=localhost
AI_AGENT_QDRANT_COLLECTION=ai_agent_knowledge_v1
AI_AGENT_OLLAMA_BASE_URL=http://localhost:11434
AI_AGENT_EMBEDDING_MODEL=bge-m3:latest